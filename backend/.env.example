# Copy to .env and adjust. Any key from config/settings.yaml can be overridden
# using the ERA_ prefix and "__" for nesting.

# Active LLM provider: ollama | claude | mock
ERA_LLM__PROVIDER=ollama

# Claude (Anthropic) - required when provider=claude
ERA_LLM__CLAUDE__API_KEY=
# ERA_LLM__CLAUDE__VISION_MODEL=claude-opus-5-5

# Ollama
# ERA_LLM__OLLAMA__BASE_URL=http://localhost:11434
# ERA_LLM__OLLAMA__VISION_MODEL=gemma3:4b

# Security
ERA_AUTH__JWT_SECRET=replace-with-a-long-random-string
